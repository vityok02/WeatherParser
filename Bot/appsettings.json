{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },

  "AllowedHosts": "*",

  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File", "Serilog.Sinks.Seq" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Micrsoft": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log.txt",
          "rollingInterval": "Day",
          "rollOnFileSizeLimit": true,
          "formatter": "Serilog.Formatting.Json.JsonFormatter"
        }
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://localhost:5341"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },

  "TimerInterval": 60000,

  "WeatherConfiguration": {
    "Path": "",
    "Parameters": ""
  },

  "GeocodingConfiguration": {
    "Path": "",
    "Token": ""
  },

  "BotConfiguration": {
    "BotToken": ""
  },

  "WeatherApi": {
    "BaseUrl": "",
    "Key": ""
  }
}